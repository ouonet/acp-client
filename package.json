{
  "name": "acp-client",
  "displayName": "ACP Client",
  "description": "Production-grade, Clean Architecture Agent Client Protocol (ACP) Client for VS Code",
  "version": "0.3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentclientprotocol/vscode-acp-client"
  },
  "engines": {
    "node": ">=20.0.0",
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:acpClient.chatView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "acpClientContainer",
          "title": "ACP Client",
          "icon": "$(robot)"
        }
      ]
    },
    "views": {
      "acpClientContainer": [
        {
          "type": "webview",
          "id": "acpClient.chatView",
          "name": "Cockpit"
        }
      ]
    },
    "commands": [
      {
        "command": "acpClient.openChat",
        "title": "ACP: Open Chat Cockpit",
        "category": "ACP"
      },
      {
        "command": "acpClient.newSession",
        "title": "ACP: New Chat Session",
        "category": "ACP"
      },
      {
        "command": "acpClient.forkSession",
        "title": "ACP: Fork Current Session",
        "category": "ACP"
      }
    ],
    "chatParticipants": [
      {
        "id": "acpClient.acpParticipant",
        "name": "acp",
        "fullName": "ACP Agent Client",
        "description": "Interact with autonomous ACP Agent in Zed-compliant protocol",
        "isSticky": true,
        "commands": [
          {
            "name": "clear",
            "description": "Clear active session"
          },
          {
            "name": "fork",
            "description": "Fork current session into new branch"
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "build:prod": "tsc --noEmit && node scripts/build.mjs --production",
    "watch": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "package": "npm run build:prod && npx @vscode/vsce package --no-dependencies"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.20.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
